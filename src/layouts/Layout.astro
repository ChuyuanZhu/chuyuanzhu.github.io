---
const links = [
  { label: 'Home', href: '/' },
  { label: 'Technical', href: '/technical/' },
  { label: 'Creative', href: '/creative/' },
  { label: 'About', href: '/about/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="The personal website and portfolio of Chuyuan Zhu."
    />
    <title>Chuyuan Zhu | Portfolio</title>
  </head>

  <body>
    <header class="site-header">
      <div class="nav-container">
        <a href="/" class="logo">Chuyuan Zhu</a>

        <nav aria-label="Main navigation">
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={
                Astro.url.pathname === link.href ? 'page' : undefined
              }
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <div class="page-container">
      <slot />
    </div>

    <footer>
      <p>© {new Date().getFullYear()} Chuyuan Zhu</p>
    </footer>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #171717;
    background: #fff;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>

<style>
  .site-header {
    border-bottom: 1px solid #eee;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .logo {
    font-size: 20px;
    font-weight: 700;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }

  nav a {
    font-size: 14px;
    color: #666;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: #111;
  }

  .page-container {
    min-height: 75vh;
  }

  footer {
    border-top: 1px solid #eee;
    text-align: center;
    padding: 24px;
    color: #888;
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .nav-container {
      flex-direction: column;
      align-items: flex-start;
    }

    nav {
      gap: 18px;
    }
  }
</style>
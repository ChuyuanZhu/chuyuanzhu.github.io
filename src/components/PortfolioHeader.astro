---
interface Props {
  category: string;
  title: string;
  description: string;
}

const { category, title, description } = Astro.props;
---

<div class="portfolio-header">
  <p class="category">{category}</p>

  <h1>{title}</h1>

  <p class="description">{description}</p>
</div>

<style>
  .category {
    font-size: 12px;
    letter-spacing: 2px;
    color: #888;content
  }

  h1 {
    font-size: clamp(36px, 6vw, 64px);
    margin: 25px 0;
  }

  .description {
    max-width: 650px;
    font-size: 19px;
    line-height: 1.7;
    color: #666;
  }
</style>

---
import Layout from '../layouts/Layout.astro';

interface Props {
  category: string;
  title: string;
  description: string;
  sectionTitle: string;
  emptyMessage?: string;
}

const {
  category,
  title,
  description,
  sectionTitle,
  emptyMessage = 'Projects coming soon.',
} = Astro.props;
---

<Layout>
  <main>
    <p class="category">{category}</p>

    <h1>{title}</h1>

    <p class="description">{description}</p>

    <section class="projects">
      <h2>{sectionTitle}</h2>

      <slot>
        <p class="empty-message">{emptyMessage}</p>
      </slot>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 30px;
  }

  .category {
    font-size: 12px;
    letter-spacing: 2px;
    color: #888;
  }

  h1 {
    font-size: clamp(36px, 6vw, 64px);
    margin: 25px 0;
  }

  .description {
    max-width: 650px;
    font-size: 19px;
    line-height: 1.7;
    color: #666;
  }

  .projects {
    margin-top: 100px;
    padding-top: 30px;
    border-top: 1px solid #ddd;
  }

  h2 {
    font-size: 24px;
  }

  .empty-message {
    color: #888;
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main>
    <p class="category">ABOUT ME</p>

    <h1>Hi, I'm Chuyuan.</h1>

    <div class="introduction">
      <p>
        I'm a Statistics and Data Science graduate from
        the University of California, Santa Barbara (UCSB),
        with an interest in technology, design, and
        creative exploration.
      </p>

      <p>
        My work and interests span software development,
        data analytics, architecture, visual arts,
        and hands-on making.
      </p>

      <p>
        This website is a growing collection of things
        I've designed, built, and explored.
      </p>
    </div>

    <section class="contact">
      <h2>Get in Touch</h2>
      <p>
        Contact information and social links coming soon.
      </p>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 30px;
  }

  .category {
    font-size: 12px;
    letter-spacing: 2px;
    color: #888;
  }

  h1 {
    font-size: clamp(36px, 6vw, 64px);
    margin: 25px 0 50px;
  }

  .introduction {
    max-width: 740px;
  }

  .introduction p {
    font-size: 19px;
    line-height: 1.9;
    color: #555;
    margin-bottom: 25px;
  }

  .contact {
    margin-top: 100px;
    padding-top: 30px;
    border-top: 1px solid #ddd;
  }

  h2 {
    font-size: 24px;
  }

  .contact p {
    color: #888;
  }
</style>

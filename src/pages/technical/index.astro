---
import PortfolioPage from '../../components/PortfolioPage.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const technicalProjects = await getCollection(
  'projects',
  ({ data }) => data.section === 'technical'
);

technicalProjects.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
---

<PortfolioPage
  category="PORTFOLIO / TECHNOLOGY"
  title="Technical Works"
  description="A collection of web applications, data projects, experiments, and things I've built."
  sectionTitle="Selected Projects"
>

  <div class="project-grid">
    {
      technicalProjects.map((project) => (
        <ProjectCard project={project} />
      ))
    }
  </div>
</PortfolioPage>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 30px;
  }

  @media (max-width: 700px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

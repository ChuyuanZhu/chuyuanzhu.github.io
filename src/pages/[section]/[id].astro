---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Generate one URL for each project
export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: {
      section: project.data.section,
      id: project.id,
    },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const {
  title,
  description,
  category,
  year,
  tags,
  cover,
  github,
  demo,
  section,
} = project.data;

const sectionName =
  section === 'technical' ? 'Technical' : 'Creative';
---

<Layout>
  <main>
    <a class="back" href={`/${section}/`}>
      ← Back to {sectionName} Works
    </a>

    <header class="project-header">
      <p class="category">{category.toUpperCase()} / {year}</p>
      <h1>{title}</h1>
      <p class="description">{description}</p>

      <div class="tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>

    {cover && (
      <img class="cover" src={cover} alt={title} />
    )}

    <article class="project-body">
      <Content />
    </article>

    {(github || demo) && (
      <div class="project-links">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
        )}

        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer">
            Live Demo ↗
          </a>
        )}
      </div>
    )}
  </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 80px 30px 120px;
  }

  .back {
    font-size: 14px;
    color: #777;
  }

  .back:hover {
    color: #111;
  }

  .project-header {
    margin: 70px 0 50px;
  }

  .category {
    font-size: 12px;
    letter-spacing: 2px;
    color: #888;
  }

  h1 {
    font-size: clamp(40px, 6vw, 72px);
    margin: 20px 0;
  }

  .description {
    font-size: 20px;
    line-height: 1.7;
    color: #666;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 25px;
  }

  .tags span {
    background: #f3f3f3;
    padding: 7px 12px;
    font-size: 12px;
    border-radius: 4px;
  }

  .cover {
    width: 100%;
    height: auto;
    border-radius: 6px;
    margin-bottom: 50px;
  }

  .project-body {
    border-top: 1px solid #ddd;
    padding-top: 35px;
    line-height: 1.8;
  }

  .project-body :global(h2) {
    margin-top: 40px;
    font-size: 26px;
  }

  .project-body :global(p) {
    font-size: 17px;
    color: #555;
  }

  .project-body :global(img) {
    max-width: 100%;
    height: auto;
  }

  .project-links {
    display: flex;
    gap: 24px;
    margin-top: 60px;
    padding-top: 30px;
    border-top: 1px solid #ddd;
  }

  .project-links a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
